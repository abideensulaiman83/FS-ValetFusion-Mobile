<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Android 12+ system splash: the adaptive launcher icon (V + brass dot) on brand navy,
         in light and dark mode alike, then the app's own dark splash page. -->
    <style name="LaunchTheme" parent="@android:style/Theme.Black.NoTitleBar">
        <item name="android:windowSplashScreenBackground">@color/launch_background</item>
        <item name="android:windowSplashScreenAnimatedIcon">@mipmap/ic_launcher</item>
        <item name="android:windowBackground">@color/launch_background</item>
    </style>
    <style name="NormalTheme" parent="@android:style/Theme.Black.NoTitleBar">
        <item name="android:windowBackground">@color/launch_background</item>
    </style>
</resources>
